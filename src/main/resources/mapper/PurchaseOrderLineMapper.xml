<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.todo_api_v2.mapper.PurchaseOrderLineMapper">

    <resultMap id="purchaseOrderLineResultMap" type="com.example.todo_api_v2.entity.PurchaseOrderLine">
        <constructor>
            <idArg   column="id"            javaType="java.lang.Long"/>
            <arg     column="po_id"         javaType="java.lang.Long"/>
            <arg     column="item_id"       javaType="java.lang.Long"/>
            <arg     column="line_no"       javaType="java.lang.Integer"/>
            <arg     column="qty"           javaType="java.math.BigDecimal"/>
            <arg     column="price"         javaType="java.math.BigDecimal"/>
            <arg     column="due_date"      javaType="java.time.LocalDate"/>
            <arg     column="status"        javaType="com.example.todo_api_v2.entity.PoLineStatus"/>
            <arg     column="received_by"   javaType="java.lang.String"/>
            <arg     column="received_at"   javaType="java.time.LocalDate"/>
            <arg     column="created_by"    javaType="java.lang.String"/>
            <arg     column="created_at"    javaType="java.time.LocalDateTime"/>
            <arg     column="updated_by"    javaType="java.lang.String"/>
            <arg     column="updated_at"    javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <select id="findByPoId" resultMap="purchaseOrderLineResultMap">
        SELECT
            id,
            po_id,
            item_id,
            line_no,
            qty,
            price,
            due_date,
            status,
            received_by,
            received_at,
            created_by,
            created_at,
            updated_by,
            updated_at
        FROM purchase_order_lines
        WHERE po_id=#{poId}
        ORDER BY line_no
    </select>

    <update id="updateReceipt">
        UPDATE purchase_order_lines SET
            status      = #{status},
            received_by = #{receivedBy},
            received_at = #{receivedAt},
            updated_by  = #{updatedBy},
            updated_at  = #{updatedAt}
        WHERE id = #{id}
    </update>

    <update id="updateReceiptCancellation">
        UPDATE purchase_order_lines SET
            status      = #{status},
            received_by = #{receivedBy},
            received_at = #{receivedAt},
            updated_by  = #{updatedBy},
            updated_at  = #{updatedAt}
        WHERE id = #{id}
    </update>

    <insert id="insertLines" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO purchase_order_lines(
            po_id,
            item_id,
            line_no,
            qty,
            price,
            due_date,
            status,
            created_by,
            updated_by
        ) VALUES
        <foreach collection="list" item = "line" separator=",">
            (
                #{line.poId},
                #{line.itemId},
                #{line.lineNo},
                #{line.qty},
                #{line.price},
                #{line.dueDate},
                #{line.status},
                #{line.createdBy},
                #{line.updatedBy}
            )
        </foreach>
    </insert>
</mapper>