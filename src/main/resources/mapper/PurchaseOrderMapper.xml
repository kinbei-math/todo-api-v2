<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.todo_api_v2.mapper.PurchaseOrderMapper">

    <resultMap id="purchaseOrderResultMap" type="com.example.todo_api_v2.entity.PurchaseOrder">
        <constructor>
            <idArg   column="id"         javaType="java.lang.Long"/>
            <arg     column="po_number"  javaType="java.lang.String"/>
            <arg     column="supplier"   javaType="java.lang.String"/>
            <arg     column="order_date" javaType="java.time.LocalDate"/>
            <arg     column="status"     javaType="com.example.todo_api_v2.entity.PoStatus"/>
            <arg     column="created_at" javaType="java.time.LocalDateTime"/>
            <arg     column="created_by" javaType="java.lang.String"/>
            <arg     column="updated_at" javaType="java.time.LocalDateTime"/>
            <arg     column="updated_by" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <!-- アノテーションのメソッド名「insert」が、id属性になります -->
    <!-- @Options の内容も、タグの属性としてそのまま書きます -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO purchase_orders (
            po_number,
            supplier,
            order_date,
            status,
            created_by,
            updated_by
        ) VALUES (
            #{poNumber},
            #{supplier},
            #{orderDate},
            #{status},
            #{createdBy},
            #{updatedBy}
        )
    </insert>

    <select id="findAll" resultMap="purchaseOrderResultMap">
        SELECT
            id,
            po_number,
            supplier,
            order_date,
            status,
            created_at,
            created_by,
            updated_at,
            updated_by
        FROM purchase_orders
        ORDER BY id
    </select>

    <select id="findById" resultMap="purchaseOrderResultMap">
        SELECT
            id,
            po_number,
            supplier,
            order_date,
            status,
            created_at,
            created_by,
            updated_at,
            updated_by
        FROM purchase_orders
        WHERE id = #{id}
    </select>

    <update id="updatePoStatus">
        UPDATE purchase_orders SET
            status     = #{status},
            updated_at = #{updatedAt},
            updated_by = #{updatedBy}
        WHERE id = #{id}
    </update>

</mapper>